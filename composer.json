{
    "name": "jeffersongoncalves/filament-gtag",
    "description": "Filament plugin for managing Google Analytics (Gtag) settings with a Settings Page powered by spatie/laravel-settings.",
    "keywords": [
        "jeffersongoncalves",
        "laravel",
        "filament",
        "filament-gtag",
        "google-analytics",
        "gtag",
        "spatie-settings"
    ],
    "homepage": "https://github.com/jeffersongoncalves/filament-gtag",
    "license": "MIT",
    "authors": [
        {
            "name": "Jefferson Gonçalves",
            "email": "gerson.simao.92@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2|^8.3",
        "jeffersongoncalves/filament-analytics-core": "^1.1",
        "jeffersongoncalves/laravel-gtag": "^3.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "JeffersonGoncalves\\Filament\\Gtag\\": "src"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint",
        "test": "vendor/bin/pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JeffersonGoncalves\\Filament\\Gtag\\GtagServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload-dev": {
        "psr-4": {
            "JeffersonGoncalves\\Filament\\Gtag\\Tests\\": "tests"
        }
    }
}
